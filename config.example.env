# Personal settings for the lab scripts.
# Copy this file to config.env and fill it in. config.env is not committed.

# Short names make all resource names unique: pf-<owner>-t02-vm
PREFIX=pf
OWNER=xy                              # your initials, 2-4 lowercase letters

# Budget alert (t01), amount in the currency of your billing account.
# Google sends the alerts to the billing administrators (your account).
BUDGET_AMOUNT=10

# Google Cloud
GCP_PROJECT=                          # empty: t01-grundlagen/create-project.sh creates one
GCP_BILLING_ACCOUNT=                  # empty: the first open billing account is used
GCP_REGION=europe-west3               # Frankfurt
GCP_ZONE=europe-west3-a
# The always free e2-micro VM exists only in us-west1, us-central1 and us-east1
GCP_FREE_ZONE=us-central1-a

# SSH key for the VMs;
# create it in the WSL shell, not in the dev container:
# ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519
SSH_PUBLIC_KEY="$HOME/.ssh/id_ed25519.pub"

# Your fork of PlaceFinder and its container images on GitHub
GITHUB_USER=your-github-user
PLACEFINDER_REPO="https://github.com/$GITHUB_USER/placefinder.git"
PLACEFINDER_IMAGE="ghcr.io/$GITHUB_USER/placefinder"
